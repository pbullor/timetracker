# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Secret key for Claude Code hooks to authenticate against /api/claude/event
CLAUDE_HOOK_API_KEY=generate-a-random-string-here

# Email of the user whose time is tracked via Claude Code hooks
CLAUDE_HOOK_USER_EMAIL=you@example.com
